# Supercell API token: https://developer.clashofclans.com
# 创建 token 时填当前公网 IP；IP 变了要重建 token。
COC_API_TOKEN=

# 绑定的部落标签，例如 #2PP
COC_CLAN_TAG=

# NoneBot2 反向 WebSocket（NapCat 作为客户端连过来）
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
ONEBOT_ACCESS_TOKEN=coc-helper-local-token

# 轮询间隔（秒）
POLL_INTERVAL_WAR=60
POLL_INTERVAL_PREP=300

# SQLite 路径
DB_PATH=data/coc.db
